# PRIVATE server configuration. Copy OUTSIDE the repository; never put real values here.
# Recommended: npm run setup:metrics -- --origin https://YOUR-TRACKER-HOST --secrets-file /private/tracker-meta.json
# Setup generates NEW access credentials/key and separate private stores. See METRICS_BACKEND.md.
# This manual template is intentionally incomplete: blank access values cause whole-panel 503.
# A GitHub repository URL is NOT your deployment origin. HTTPS only, no trailing slash.
# Node >=22.13 required for built-in node:sqlite (Node 22.22 recommended).
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=https://tracker.example.com
# Fail closed for the ENTIRE panel, including legacy APIs and root HTML.
METRICS_ENABLED=true
METRICS_USERNAME=
METRICS_PASSWORD=
# Optional private runtime JSON; path only, never a URL. See METRICS_BACKEND.md.
# METRICS_SECRETS_FILE=/root/.hermes/secrets/tracker-panel-meta.json
# Explicit environment values override JSON, INCLUDING blank values.
# Leave these commented when using the file. Separate Instagram Login credentials:
# META_APP_ID=
# META_APP_SECRET=
API_VERSION=v25.0
# Separate Facebook Login app credentials; do not reuse Instagram credentials blindly.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v26.0
# Random 32-byte key as 64 hexadecimal chars. Back it up; NEVER rotate with app secret.
TOKEN_ENCRYPTION_KEY=
# NEW private directory dedicated to Tracker. NEVER point at existing Lume data.
DATA_DIR=/var/lib/tracker-metrics
# Existing tracker account JSON directory (separate from encrypted OAuth store).
DB_PATH=/var/lib/tracker-panel
